.venv/
.venv-py*/
__pycache__/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
# Your own watchlist and state stay out of the repo.
*.db

# Tax documents and anything derived from them never belong here.
*.pdf
*.xlsx
*.xls
*.docx
*.jpg
*.jpeg
*.png
*.heic
TaxData/
redacted/
# The household budget (its plan, rules, bank and card exports, ledger) lives in the workspace, never here.
# tests/ only ever holds made-up files, so a CSV is allowed in tests/data/ alone.
budget/
statements/
actuals/
ledger.jsonl
rules.toml
budget-*.toml
*.csv
!tests/data/*.csv
# Rendered videos and their clips (scripts/videos/make-videos); the published ones are copied to site/
scripts/videos/out/
# except the app's own icons, rendered from the SVGs beside them by scripts/make_icons.py
!taxtrace/static/icon-*.png
!taxtrace/static/apple-touch-icon.png
# and the landing page's pictures, rendered from the made-up demo by scripts/videos/posters.py
!site/og.jpg
!site/taxtrace-demo.jpg
!site/tutorials/taxtrace-*.jpg
